{
  "name": "matrix-ecommerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"pnpm --filter @matrix-ecommerce/api dev\" \"pnpm --filter @matrix-ecommerce/web dev\"",
    "build": "pnpm --filter @matrix-ecommerce/api build && pnpm --filter @matrix-ecommerce/web build",
    "build:web": "pnpm --filter @matrix-ecommerce/web build",
    "build:api": "pnpm --filter @matrix-ecommerce/api build",
    "railway:build:api": "pnpm --filter @matrix-ecommerce/api db:generate && pnpm --filter @matrix-ecommerce/api build",
    "railway:start:api": "pnpm --filter @matrix-ecommerce/api start:railway",
    "railway:build:web": "pnpm --filter @matrix-ecommerce/web build",
    "railway:start:web": "bash apps/web/start.sh",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,json,md}\"",
    "db:generate": "pnpm --filter @matrix-ecommerce/api db:generate",
    "db:deploy": "pnpm --filter @matrix-ecommerce/api db:deploy",
    "db:patch:snapshots": "pnpm --filter @matrix-ecommerce/api db:patch:snapshots",
    "db:patch:auth-email": "pnpm --filter @matrix-ecommerce/api db:patch:auth-email",
    "db:patch:coupons": "pnpm --filter @matrix-ecommerce/api db:patch:coupons",
    "db:patch:product-category-nullable": "pnpm --filter @matrix-ecommerce/api db:patch:product-category-nullable",
    "db:patch:prod": "pnpm --filter @matrix-ecommerce/api db:patch:prod",
    "db:migrate": "pnpm --filter @matrix-ecommerce/api db:migrate",
    "db:seed": "pnpm --filter @matrix-ecommerce/api db:seed",
    "db:studio": "pnpm --filter @matrix-ecommerce/api db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
