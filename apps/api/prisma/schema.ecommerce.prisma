generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String             @id @default(uuid())
  email                  String?            @unique
  phone                  String?            @unique
  password_hash          String
  status                 String             @default("active")
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt
  addresses              Address[]
  assignedConversations  Conversation[]     @relation("AssignedConversations")
  blogPosts              BlogPost[]
  cart                   Cart?
  conversations          Conversation[]     @relation("ConversationUser")
  customerProfile        CustomerProfile?
  mediaAssets            MediaAsset[]
  oauthAccounts          OAuthAccount[]
  orders                 Order[]
  products               Product[]          @relation("SellerProducts")
  refreshTokens          RefreshToken[]
  roles                  UserRole[]
  reviews                Review[]
  reviewedPaymentProofs  PaymentProof[]     @relation("PaymentProofReviewer")
  submittedPaymentProofs PaymentProof[]     @relation("PaymentProofSubmitter")
  sellerProfile          SellerProfile?
  sellerOrderItems       OrderItem[]        @relation("SellerOrderItems")
  createdOrderEvents     OrderStatusEvent[] @relation("OrderStatusEventCreator")
  cartItemsAsSeller      CartItem[]         @relation("CartItemSeller")
  customerProfileNotes    CustomerProfile[]   @relation("CustomerProfileInternalNoteAuthor")

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Role {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  user_id String
  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model AuthEmailOtp {
  id         String    @id @default(uuid())
  email      String
  purpose    String
  code_hash  String
  expires_at DateTime
  consumed_at DateTime?
  created_at DateTime  @default(now())

  @@index([email, purpose])
  @@index([expires_at])
  @@map("auth_email_otps")
}

model AuthPhoneOtp {
  id          String    @id @default(uuid())
  phone       String
  purpose     String
  code_hash   String
  attempts    Int       @default(0)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  @@index([phone, purpose])
  @@index([expires_at])
  @@map("auth_phone_otps")
}

model AuthOtpBlock {
  id            String   @id @default(uuid())
  channel       String
  identifier    String
  reason        String?
  blocked_until DateTime
  created_at    DateTime @default(now())

  @@index([channel, identifier])
  @@index([blocked_until])
  @@map("auth_otp_blocks")
}

model OAuthAccount {
  id                  String   @id @default(uuid())
  user_id             String
  provider            String
  provider_account_id String
  created_at          DateTime @default(now())
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("oauth_accounts")
}

model CustomerProfile {
  user_id                   String      @id
  full_name                 String?
  nationality               String?
  passport_name             String?
  preferred_language        String?
  preferred_currency        String?     @default("BDT")
  preferred_contact_channel String?
  wechat_id                 String?
  marketing_consent         Boolean     @default(false)
  avatar_asset_id           String?
  internal_rating           Int?
  internal_note             String?
  internal_note_updated_by  String?
  internal_note_updated_at  DateTime?
  created_at                DateTime    @default(now())
  updated_at                DateTime    @updatedAt
  user                      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  avatarAsset               MediaAsset? @relation("CustomerProfileAvatar", fields: [avatar_asset_id], references: [id], onDelete: SetNull)
  internalNoteUpdatedBy     User?       @relation("CustomerProfileInternalNoteAuthor", fields: [internal_note_updated_by], references: [id], onDelete: SetNull)

  @@map("customer_profiles")
}

model SellerProfile {
  id              String      @id @default(uuid())
  user_id         String      @unique
  shop_name       String
  display_name    String?
  contact_name    String?
  whatsapp        String?
  wechat          String?
  email           String?
  website         String?
  description     String?
  address_text    String?
  service_area    String?
  verified        Boolean     @default(false)
  is_active       Boolean     @default(true)
  rating          Float?
  review_count    Int         @default(0)
  logo_asset_id   String?
  banner_asset_id String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logoAsset       MediaAsset? @relation("SellerLogo", fields: [logo_asset_id], references: [id], onDelete: SetNull)
  bannerAsset     MediaAsset? @relation("SellerBanner", fields: [banner_asset_id], references: [id], onDelete: SetNull)

  @@index([verified])
  @@index([is_active])
  @@map("seller_profiles")
}

model Address {
  id           String   @id @default(uuid())
  user_id      String
  name         String
  phone        String
  country      String   @default("Bangladesh")
  city         String
  address_line String
  postal_code  String?
  geo_lat      Float?
  geo_lng      Float?
  notes        String?
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([user_id])
  @@map("addresses")
}

model MediaAsset {
  id                     String            @id @default(uuid())
  r2_key                 String            @unique
  public_url             String
  mime_type              String
  size                   Int
  uploaded_by            String
  created_at             DateTime          @default(now())
  category               String?
  main_category_id       String?
  brand_id               String?
  brand_model_id         String?
  product_type_id        String?
  height                 Int?
  tags                   String[]          @default([])
  thumbnail_key          String?
  thumbnail_url          String?
  width                  Int?
  uploader               User              @relation(fields: [uploaded_by], references: [id])
  mainCategory           MainCategory?     @relation(fields: [main_category_id], references: [id], onDelete: SetNull)
  taxonomyBrand          Brand?            @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  brandModel             BrandModel?       @relation(fields: [brand_model_id], references: [id], onDelete: SetNull)
  productType            ProductType?      @relation(fields: [product_type_id], references: [id], onDelete: SetNull)
  customerProfileAvatars CustomerProfile[] @relation("CustomerProfileAvatar")
  sellerLogoAssets       SellerProfile[]   @relation("SellerLogo")
  sellerBannerAssets     SellerProfile[]   @relation("SellerBanner")
  productCovers          Product[]         @relation("ProductCover")
  productVideos          Product[]         @relation("ProductVideo")
  blogCovers             BlogPost[]        @relation("BlogCover")
  homepageBannerCovers   HomepageBanner[]  @relation("HomepageBannerCover")
  homepageOfferCovers    HomepageOffer[]   @relation("HomepageOfferCover")
  paymentProofs          PaymentProof[]

  @@index([uploaded_by])
  @@index([category])
  @@index([tags])
  @@index([main_category_id])
  @@index([brand_id])
  @@index([brand_model_id])
  @@index([product_type_id])
  @@map("media_assets")
}

model BlogPost {
  id             String      @id @default(uuid())
  slug           String      @unique
  title          String
  excerpt        String?
  content_md     String
  cover_asset_id String?
  status         String      @default("draft")
  published_at   DateTime?
  created_by     String
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  author         User        @relation(fields: [created_by], references: [id], onDelete: Cascade)
  coverAsset     MediaAsset? @relation("BlogCover", fields: [cover_asset_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([published_at])
  @@map("blog_posts")
}

model HomepageBanner {
  id             String      @id @default(uuid())
  title          String
  subtitle       String?
  link           String?
  cta_text       String?     @default("Learn More")
  cover_asset_id String?
  is_active      Boolean     @default(true)
  sort_order     Int         @default(0)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  coverAsset     MediaAsset? @relation("HomepageBannerCover", fields: [cover_asset_id], references: [id], onDelete: SetNull)

  @@index([is_active, sort_order])
  @@map("homepage_banners")
}

model HomepageOffer {
  id                String      @id @default(uuid())
  title             String
  subtitle          String?
  description       String?
  offer_type        String      @default("promotion")
  value             Float?
  currency          String      @default("BDT")
  link              String?
  cover_asset_id    String?
  gallery_asset_ids Json?
  is_active         Boolean     @default(true)
  sort_order        Int         @default(0)
  valid_from        DateTime?
  valid_until       DateTime?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  coverAsset        MediaAsset? @relation("HomepageOfferCover", fields: [cover_asset_id], references: [id], onDelete: SetNull)

  @@index([is_active, sort_order])
  @@index([valid_from])
  @@index([valid_until])
  @@map("homepage_offers")
}

model HomepageHotDeal {
  id          String   @id @default(uuid())
  product_id  String   @unique
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([is_active, sort_order])
  @@map("homepage_hot_deals")
}

model HomepageVisualMenuItem {
  id                 String   @id @default(uuid())
  section_key        String
  section_label      String
  section_sort_order Int      @default(0)
  title              String
  search_keyword     String
  image_url          String
  image_alt          String?
  sort_order         Int      @default(0)
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([is_active, section_sort_order, sort_order])
  @@index([section_key])
  @@map("homepage_visual_menu_items")
}

model ProductCategory {
  id          String            @id @default(uuid())
  parent_id   String?
  name        String
  slug        String            @unique
  description String?
  icon        String?
  sort_order  Int               @default(0)
  is_active   Boolean           @default(true)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([parent_id])
  @@index([slug])
  @@map("product_categories")
}

model MainCategory {
  id                   String          @id @default(uuid())
  name                 String
  slug                 String          @unique
  description          String?
  sort_order           Int             @default(0)
  is_active            Boolean         @default(true)
  requires_brand_model Boolean         @default(false)
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  brandLinks           CategoryBrand[]
  productTypes         ProductType[]
  products             Product[]
  mediaAssets          MediaAsset[]

  @@index([is_active, sort_order])
  @@index([slug])
  @@map("main_categories")
}

model Brand {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  sort_order    Int             @default(0)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  categoryLinks CategoryBrand[]
  models        BrandModel[]
  products      Product[]
  mediaAssets   MediaAsset[]

  @@index([is_active, sort_order])
  @@index([slug])
  @@map("brands")
}

model CategoryBrand {
  id               String       @id @default(uuid())
  main_category_id String
  brand_id         String
  sort_order       Int          @default(0)
  created_at       DateTime     @default(now())
  brand            Brand        @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  mainCategory     MainCategory @relation(fields: [main_category_id], references: [id], onDelete: Cascade)

  @@unique([main_category_id, brand_id])
  @@index([brand_id])
  @@index([main_category_id, sort_order])
  @@map("main_category_brands")
}

model BrandModel {
  id         String    @id @default(uuid())
  brand_id   String
  name       String
  slug       String
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  brand      Brand     @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  products   Product[]
  mediaAssets MediaAsset[]

  @@unique([brand_id, slug])
  @@index([brand_id, is_active, sort_order])
  @@map("brand_models")
}

model ProductType {
  id               String       @id @default(uuid())
  main_category_id String
  name             String
  slug             String
  sort_order       Int          @default(0)
  is_active        Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  mainCategory     MainCategory @relation(fields: [main_category_id], references: [id], onDelete: Cascade)
  products         Product[]
  mediaAssets      MediaAsset[]

  @@unique([main_category_id, slug])
  @@index([main_category_id, is_active, sort_order])
  @@map("product_types")
}

model Product {
  id                String          @id @default(uuid())
  seller_id         String
  category_id       String?
  main_category_id  String?
  brand_id          String?
  brand_model_id    String?
  product_type_id   String?
  title             String
  description       String?
  price             Float
  currency          String          @default("BDT")
  original_price    Float?
  stock_qty         Int             @default(0)
  minimum_order_qty Int             @default(1)
  status            String          @default("draft")
  source_kind       String          @default("manual")
  source_url        String?
  product_url       String?
  external_id       String?
  vendor_id         String?
  vendor_name       String?
  shop_url          String?
  cover_asset_id    String?
  brand             String?
  dimensions        Json?
  rating            Float?
  review_count      Int             @default(0)
  sku               String?         @unique
  specifications    Json?
  tags              Json?
  weight_kg         Float?
  gallery_asset_ids Json?
  video_asset_id    String?
  is_featured       Boolean         @default(false)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]
  category          ProductCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  coverAsset        MediaAsset?     @relation("ProductCover", fields: [cover_asset_id], references: [id], onDelete: SetNull)
  videoAsset        MediaAsset?     @relation("ProductVideo", fields: [video_asset_id], references: [id], onDelete: SetNull)
  mainCategory      MainCategory?   @relation(fields: [main_category_id], references: [id], onDelete: SetNull)
  taxonomyBrand     Brand?          @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  brandModel        BrandModel?     @relation(fields: [brand_model_id], references: [id], onDelete: SetNull)
  productType       ProductType?    @relation(fields: [product_type_id], references: [id], onDelete: SetNull)
  seller            User            @relation("SellerProducts", fields: [seller_id], references: [id], onDelete: Restrict)
  homepageHotDeals  HomepageHotDeal[]

  @@index([seller_id])
  @@index([category_id])
  @@index([main_category_id])
  @@index([brand_id])
  @@index([brand_model_id])
  @@index([product_type_id])
  @@index([status])
  @@index([rating])
  @@index([sku])
  @@index([source_kind])
  @@map("products")
}

model ProductSearchVector {
  id              String   @id @default(uuid())
  product_id      String   @unique
  main_category_id String?
  category_id     String?
  product_type_id String?
  brand_id        String?
  brand_model_id  String?
  searchable_text String
  tokens          String[] @default([])
  updated_at      DateTime @updatedAt

  @@index([main_category_id])
  @@index([category_id])
  @@index([product_type_id])
  @@index([brand_id])
  @@index([brand_model_id])
  @@index([tokens])
  @@map("product_search_vectors")
}

model SearchKeywordStat {
  id               String   @id @default(uuid())
  keyword          String
  normalized_key   String   @unique
  search_count     Int      @default(1)
  result_count_sum Int      @default(0)
  last_result_count Int     @default(0)
  last_searched_at DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([search_count, last_searched_at])
  @@index([last_searched_at])
  @@map("search_keyword_stats")
}

model ShippingCharge {
  id            String   @id @default(uuid())
  delivery_area String   @unique
  cost          Float
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([is_active])
  @@map("shipping_charges")
}

model Cart {
  id         String     @id @default(uuid())
  user_id    String     @unique
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  items      CartItem[]
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id                String   @id @default(uuid())
  cart_id           String
  product_id        String
  seller_id         String
  qty               Int
  price_snapshot    Float
  currency_snapshot String   @default("BDT")
  title_snapshot    String?
  sku_details_snapshot Json?
  image_url_snapshot String?
  source_url_snapshot String?
  product_url_snapshot String?
  seller_name_snapshot String?
  vendor_id_snapshot String?
  shop_url_snapshot String?
  selected_shipping_method String?
  estimated_weight_kg Float?
  created_at        DateTime @default(now())
  cart              Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)
  seller            User     @relation("CartItemSeller", fields: [seller_id], references: [id], onDelete: Restrict)

  @@index([cart_id])
  @@index([seller_id])
  @@map("cart_items")
}

model Order {
  id                  String             @id @default(uuid())
  order_number        String             @unique
  user_id             String
  status              String             @default("pending_payment")
  payment_status      String             @default("unsubmitted")
  currency            String             @default("BDT")
  subtotal            Float
  discount_amount     Float              @default(0)
  coupon_code         String?
  coupon_id           String?
  shipping_fee        Float              @default(0)
  payment_method      String             @default("cash_on_delivery")
  total               Float
  shipping_method     String             @default("air")
  shipping_address_id String
  notes               String?
  admin_notes         String?
  seller_notes        String?
  seller_archived_at  DateTime?
  admin_archived_at   DateTime?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  items               OrderItem[]
  shippingAddress     Address            @relation(fields: [shipping_address_id], references: [id], onDelete: Restrict)
  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shippingUpdates     ShippingUpdate[]
  statusEvents        OrderStatusEvent[]
  paymentProofs       PaymentProof[]
  couponRedemption    CouponRedemption?

  @@index([user_id])
  @@index([coupon_code])
  @@index([status])
  @@index([payment_status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id                String    @id @default(uuid())
  order_id          String
  product_id        String
  seller_id         String
  qty               Int
  price_snapshot    Float
  currency_snapshot String    @default("BDT")
  title_snapshot    String?
  sku_details_snapshot Json?
  image_url_snapshot String?
  source_url_snapshot String?
  product_url_snapshot String?
  seller_name_snapshot String?
  vendor_id_snapshot String?
  shop_url_snapshot String?
  selected_shipping_method String?
  estimated_weight_kg Float?
  purchase_order_no String?
  tracking_no      String?
  seller_status     String    @default("pending_review")
  seller_note       String?
  reviewed_at       DateTime?
  created_at        DateTime  @default(now())
  order             Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [product_id], references: [id], onDelete: Restrict)
  seller            User      @relation("SellerOrderItems", fields: [seller_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([seller_id])
  @@index([seller_status])
  @@index([created_at])
  @@map("order_items")
}

model ShippingUpdate {
  id          String   @id @default(uuid())
  order_id    String
  status_text String
  note        String?
  created_at  DateTime @default(now())
  order       Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("shipping_updates")
}

model OrderStatusEvent {
  id          String   @id @default(uuid())
  order_id    String
  status_from String?
  status_to   String
  note        String?
  created_by  String?
  created_at  DateTime @default(now())
  order       Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  creator     User?    @relation("OrderStatusEventCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([status_to])
  @@index([created_at])
  @@map("order_status_events")
}

model PaymentProof {
  id           String     @id @default(uuid())
  order_id     String
  asset_id     String
  submitted_by String?
  amount       Float?
  status       String     @default("submitted")
  notes        String?
  reviewed_by  String?
  reviewed_at  DateTime?
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  order        Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  asset        MediaAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  reviewer     User?      @relation("PaymentProofReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  submitter    User?      @relation("PaymentProofSubmitter", fields: [submitted_by], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([status])
  @@map("payment_proofs")
}

model Coupon {
  id                  String             @id @default(uuid())
  code                String             @unique
  title               String?
  description         String?
  discount_type       String
  discount_value      Float
  max_discount_amount Float?
  min_order_amount    Float              @default(0)
  currency            String             @default("BDT")
  starts_at           DateTime?
  ends_at             DateTime?
  usage_limit         Int?
  usage_count         Int                @default(0)
  per_user_limit      Int                @default(1)
  is_active           Boolean            @default(true)
  created_by          String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  redemptions         CouponRedemption[]

  @@index([code])
  @@index([is_active])
  @@index([starts_at])
  @@index([ends_at])
  @@map("coupons")
}

model CouponRedemption {
  id              String   @id @default(uuid())
  coupon_id       String
  user_id         String
  order_id        String   @unique
  coupon_code     String
  discount_amount Float
  created_at      DateTime @default(now())
  coupon          Coupon   @relation(fields: [coupon_id], references: [id], onDelete: Restrict)
  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([coupon_id])
  @@index([user_id])
  @@index([coupon_code])
  @@map("coupon_redemptions")
}

model Review {
  id            String   @id @default(uuid())
  user_id       String
  entity_type   String
  entity_id     String
  rating        Int
  title         String?
  comment       String?
  is_verified   Boolean  @default(false)
  helpful_count Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([entity_type, entity_id])
  @@index([user_id])
  @@index([rating])
  @@index([created_at])
  @@map("reviews")
}

model Conversation {
  id                   String    @id @default(uuid())
  channel              String
  user_id              String?
  external_channel     String?
  external_from        String?
  external_to          String?
  external_thread_key  String?   @unique
  mode                 String    @default("AI")
  assigned_user_id     String?
  assigned_at          DateTime?
  last_inbound_at      DateTime?
  last_outbound_at     DateTime?
  last_message_preview String?
  created_at           DateTime  @default(now())
  user                 User?     @relation("ConversationUser", fields: [user_id], references: [id], onDelete: SetNull)
  assignedUser         User?     @relation("AssignedConversations", fields: [assigned_user_id], references: [id], onDelete: SetNull)
  messages             Message[]

  @@index([user_id])
  @@index([external_from])
  @@index([mode])
  @@index([assigned_user_id])
  @@map("conversations")
}

model Message {
  id              String       @id @default(uuid())
  conversation_id String
  role            String
  content         String
  direction       String?
  provider        String?
  provider_sid    String?
  status          String?
  meta_json       Json?
  created_at      DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([provider_sid])
  @@map("messages")
}
