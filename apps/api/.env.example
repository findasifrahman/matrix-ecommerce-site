DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/matrixecommerce?schema=public
NODE_ENV=production
PORT=3000

APP_BASE_URL=https://www.matrixshop.bd
WEB_APP_URL=https://www.matrixshop.bd
API_BASE_URL=https://api.matrixshop.bd
ALLOWED_ORIGINS=https://www.matrixshop.bd,https://matrixshop.bd

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES=12h
JWT_REFRESH_EXPIRES=14d

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.matrixshop.bd/api/auth/google/callback

# Optional: SMTP mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Matrixshop <no-reply@matrixshop.bd>"
SMTP_IP_FAMILY=4

# Optional: Cloudflare R2 media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Optional: Turnstile
CLOUDFLARE_TURNSTILE_SECRET=

# Optional: SMS / notifications
SMS_BD_API_KEY=
SMS_BD_TIMEOUT_MS=10000
WECOM_GROUP_BOT_WEBHOOK_URL=
